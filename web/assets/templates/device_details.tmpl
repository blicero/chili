{{ define "device_details" }}
{{/* Created on 27. 07. 2026 */}}
{{/* Time-stamp: <2026-08-11 12:32:44 krylon> */}}
<!DOCTYPE html>
<html>
  {{ template "head" . }}

  <body>
    {{ template "intro" . }}

    <table>
      <tr>
        <th>Name</th>
        <td>{{ .Device.Name }}</td>

        <th>Address</th>
        <td>{{ .Device.Addr }}</td>

        <th>OS</th>
        <td>{{ .Device.OS }}</td>

        <th>Last Contact</th>
        <td>{{ fmt_time_minute .Device.LastContact }}</td>
      </tr>

      <tr>
        {{ $dmi := (index .Attributes (attribute "DMI")) }}
        {{ if ne $dmi nil }}
        <th>Vendor</th>
        <td>{{ $dmi.Value.Vendor }}</td>

        <th>Model</th>
        <td>{{ $dmi.Value.Model }}</td>

        <th>Serial number</th>
        <td>{{ $dmi.Value.Serial }}</td>

        <th>CPU</th>
        <td>{{ $dmi.Value.CPU }}</td>
        {{ else }}
        <th>Vendor</th>
        <td>&nbsp;</td>

        <th>Model</th>
        <td>&nbsp;</td>

        <th>Serial number</th>
        <td>&nbsp;</td>

        <th>CPU</th>
        <td>&nbsp;</td>
        {{ end }}
      </tr>

      <tr>
        <th>Free Disk Space</th>
        <td>
          {{- with (index .Attributes (attribute "DiskSpace")) }}
          {{ .Value }} %
          {{ end -}}
        </td>

        <th>Load Average</th>
        <td>
          {{ with (index .Attributes (attribute "Uptime")) }}
          {{ fmt_float (index .Value.Load 0) }} /
          {{ fmt_float (index .Value.Load 1) }} /
          {{ fmt_float (index .Value.Load 2) }}
          {{ end }}
        </td>
      </tr>

    </table>

    <hr />

    <div class="container" id="attributes">
      <div id="updates" class="row">
        {{ with (index .Attributes (attribute "Updates")) }}
        <div class="row-xs">
          <h2>Pending Updates</h2>
          ({{ fmt_time_minute .Timestamp }})
        </div>

        <div class="row urgent">
          {{ range .Value }}
          {{ . }}<br />
          {{ end }}
          {{ else }}
          (none)
          {{ end }}
        </div>
      </div>

      <div class="row" id="services">
        <div class="row-xs">
          <h2>Services</h2>
        </div>

        <div class="row left">
          {{ with (index .Attributes (attribute "Services")) }}

          {{ with .Value.Failed }}
          <h3>Failed</h3>
          <div class="failed">
            <p>
              {{ range . }}
              {{ . }}<br />
              {{ end }}
            </p>
          </div>
          {{ end }}

          <button class="btn btn-success btn-sm"
            data-bs-toggle="collapse"
            href="#svc_running"
            aria-expanded="false"
            aria-controls="#svc_running">
            Running
          </button>

          <div class="collapse" id="svc_running">
            {{ range .Value.Running }}
            {{ . }}<br />
            {{ end }}
          </div>

          {{ end }}
        </div>
      </div> <!-- end services -->

      <div class="row">
        &nbsp;
      </div>

      <div class="row" id="packages">
        <div class="row-xs">
          <h2>Installed Software</h2>
        </div>

        <div class="row">
          <button class="btn btn-warning btn-sm"
            data-bs-toggle="collapse"
            href="#pkg_list"
            aria-expanded="false"
            aria-controls="#pkg_list">
            Installed Software
          </button>

          <div class="collapse box" id="pkg_list">
            {{ with (index .Attributes (attribute "Packages")) }}
            {{ range .Value }}
            {{ . }} <br />
            {{ end }}
            {{ end }}
          </div>
        </div>
      </div><!-- end packages -->

      <div class="row">
        &nbsp;
      </div>

      <div class="row" id="snmp">
        <div class="row-xs">
          <h2>SNMP</h2>
        </div>
        <div class="row">
          {{ with (index .Attributes (attribute "SNMP")) }}
          <dl class="box">
            {{ range $name, $val :=  .Value }}
            <dt>{{ $name }}</dt>
            <dd>{{ $val }}</dd>
            {{ end }}
          </dl>
          {{ end }}
        </div>
      </div><!-- end snmp -->
    </div>

    {{ template "footer" . }}
  </body>
</html>
{{ end }}
